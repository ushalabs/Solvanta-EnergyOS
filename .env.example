# ==============================================================================
# Solvanta Local Development Environment Variables
# COPY THIS FILE TO .env FOR LOCAL USE. NEVER COMMIT SENSITIVE SECRETS.
# ==============================================================================

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=solvanta-local-dev-insecure-secret-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database (Docker Compose)
POSTGRES_USER=solvanta_user
POSTGRES_PASSWORD=solvanta_dev_password
POSTGRES_DB=solvanta_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://solvanta_user:solvanta_dev_password@localhost:5432/solvanta_db

# n8n Workflow Automation (Docker Compose)
N8N_PORT=5678
N8N_HOST=localhost
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=solvanta_admin
N8N_BASIC_AUTH_PASSWORD=solvanta_n8n_dev_password
N8N_WEBHOOK_URL=http://localhost:5678/

# Mobile Client API Connectivity
# NOTE FOR ANDROID EMULATOR: Use http://10.0.2.2:8000 to reach host PC localhost
# NOTE FOR PHYSICAL DEVICE: Use your PC LAN IP, e.g. http://192.168.1.100:8000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# MCP (Model Context Protocol) Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_TRANSPORT=stdio

# Local AI Assistant / LLM Provider (OPTIONAL - Server-side only)
# Degraded tool-only mode is available without API key
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
