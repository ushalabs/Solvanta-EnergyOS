          },
          "conditions": [
            {
              "id": "9d9b4bb7-c0d0-45c9-8957-e8daf58b9d32",
              "leftValue": "={{ $json.terminal }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
