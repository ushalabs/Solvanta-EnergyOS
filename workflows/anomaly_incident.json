        "jsCode": "const input=$json.body || $json; return [{json:{building_id:input.building_id || 'CONFIGURE_BUILDING_ID',event_id:input.event_id || 'n8n-'+$execution.id+'-anomaly_incident',correlation_id:input.correlation_id || 'n8n-'+$execution.id,kind:'anomaly_incident',incident_id:input.incident_id || null,outages:input.outages || [{start_min:480,end_min:600}],use_generator:input.use_generator || false,expiry_minutes:input.expiry_minutes || 60}}];"
      }
    },
    {
