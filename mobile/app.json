{
  "expo": {
    "name": "Solvanta",
    "slug": "solvanta-energyos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "solvanta",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#090B0A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solvanta.energyos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090B0A"
      },
      "package": "com.solvanta.energyos"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
