{
  "expo": {
    "name": "Solvanta",
    "slug": "solvanta-energyos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "solvanta",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solvanta.energyos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090B0A"
      },
      "package": "com.solvanta.energyos",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "backgroundColor": "#090B0A",
          "resizeMode": "contain"
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "@reactvision/react-viro",
        {
          "provider": "none",
          "android": {
            "xRMode": [
              "AR"
            ]
          },
          "ios": {
            "cameraUsagePermission": "Solvanta uses the camera to show your saved rooftop panel layout on a flat surface in AR. The preview is a visualization, not a measurement."
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ea4c46a1-1f3c-4390-9e1a-a1a50ca74dff"
      }
    },
    "owner": "7ukzu"
  }
}