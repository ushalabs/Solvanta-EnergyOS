{
  "expo": {
    "name": "Solvanta",
    "slug": "solvanta-energyos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "solvanta",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solvanta.energyos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090B0A"
      },
      "package": "com.solvanta.energyos",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090B0A",
          "resizeMode": "contain"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}