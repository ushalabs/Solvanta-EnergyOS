# ==============================================================================
# Solvanta Mobile Environment Configuration
# ==============================================================================
# For local development, copy this file to mobile/.env:
#   cp .env.example .env
#
# 1. Android Emulator (Default - no edit needed):
#    10.0.2.2 is the special Android loopback address to your host PC localhost
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
#
# 2. Physical Device on Local Wi-Fi / LAN:
#    Replace with your PC's actual local IPv4 address (run `ipconfig` on Windows)
#    Make sure Windows Firewall allows inbound connections on port 8000
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000/api/v1
#
# 3. Web Preview / iOS Simulator:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
