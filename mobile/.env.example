# Automatically follow the current Expo LAN host on port 8000.
# Only override for a separately hosted API (HTTPS for deployed builds).
EXPO_PUBLIC_API_BASE_URL=

# Firebase Web App Configuration (from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google OAuth Web Client ID (Client Type 3 in Google Cloud / Firebase Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
